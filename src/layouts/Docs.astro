---
/**
 * A developer docs page inside the gridline frame: the section tree on the left (DocsTree, which
 * folds the API reference's methods, commands and types under their index pages), the page in
 * the middle, an "On this page" list on the right from 1280px up. Below 1024px the tree folds
 * into a disclosure above the page. The search dialog (Ctrl+K) covers both collections;
 * Pagefind indexes only the article, so the menus, the footer and the neighbour links stay out
 * of it.
 */
import type { MarkdownHeading } from 'astro';
import { ArrowLeft, ArrowRight, ChevronRight, Search } from '@lucide/astro';
import Base from '@/layouts/Base.astro';
import { article, breadcrumbs, lastModified } from '@/lib/seo';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/components/Search.astro';
import AdUnit from '@/components/AdUnit.astro';
import DocsTree from '@/components/DocsTree.astro';
import { cn } from '@/lib/cn';
import { BASE, LABEL, getNav, type Kind } from '@/lib/docs';

interface Props {
  kind: Kind;
  /** The page's h1. */
  title: string;
  description?: string;
  /** Where the page sits, for the breadcrumb: its sidebar section, or its index page. */
  parent?: { title: string; href?: string };
  /** A reference page's kind: Method, Edit command, Type. */
  badge?: string;
  /** The title is an API name, set in code type. */
  code?: boolean;
  /** The page's path without a trailing slash, as the sidebar links it. */
  current: string;
  headings: MarkdownHeading[];
  editUrl?: string;
  /** The <title> for search results, when the h1 alone says too little. */
  seoTitle?: string;
  /** The description is for search results only: the page's own prose opens with the same. */
  hideLead?: boolean;
}

const {
  kind,
  title,
  description,
  parent,
  badge,
  code,
  current,
  headings,
  editUrl,
  seoTitle,
  hideLead,
} = Astro.props;
const { groups, flat } = await getNav(kind);
const index = flat.findIndex((item) => item.href === current);
const prev = index > 0 ? flat[index - 1] : undefined;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const isHome = current === BASE[kind];
const pageTitle = seoTitle ?? (isHome ? LABEL[kind] : `${title} · ${LABEL[kind]}`);
const path = `${current}/`;
const modified = lastModified(path);
const ld = [
  article({
    site: Astro.site,
    path,
    headline: title,
    description,
    image: '/og.png',
    modified,
    type: 'TechArticle',
  }),
  breadcrumbs(Astro.site, [
    ['Concat', '/'],
    [LABEL[kind], `${BASE[kind]}/`],
    ...(parent?.href ? ([[parent.title, `${parent.href}/`]] as Array<[string, string]>) : []),
    ...(isHome ? [] : ([[title, path]] as Array<[string, string]>)),
  ]),
];
const label = `${LABEL[kind]} pages`;
// A description may name code in backticks: set as code in the lead, plain in search results.
const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const leadHtml = description
  ? escapeHtml(description).replace(/`([^`]+)`/g, '<code>$1</code>')
  : undefined;
const metaDescription = description?.replace(/`/g, '');
---

<Base
  title={`${pageTitle} · Concat`}
  description={metaDescription}
  type="article"
  modified={modified}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  <Header />

  <main class="pt-16">
    <div class="container-x py-8 lg:py-12">
      <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[15rem_minmax(0,50rem)_12rem] xl:justify-between xl:gap-10">
        <div class="mb-3 lg:hidden">
          <button type="button" class="docs-search" data-search-open>
            <Search class="size-4" aria-hidden="true" />
            Search
            <kbd class="kbd ml-auto text-[11px] text-fg-subtle" data-search-key>
              Ctrl K
            </kbd>
          </button>
        </div>

        <details class="group/nav mb-8 rounded-lg border border-line lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium [&::-webkit-details-marker]:hidden">
            {LABEL[kind]}
            <ChevronRight
              class="size-4 text-fg-subtle transition-transform duration-300 ease-out-expo group-open/nav:rotate-90"
              aria-hidden="true"
            />
          </summary>
          <div class="border-t border-line px-2 py-3">
            <DocsTree groups={groups} current={current} label={label} />
          </div>
        </details>

        <aside class="hidden lg:block">
          <div class="docs-rail" data-lenis-prevent>
            <button type="button" class="docs-search" data-search-open>
              <Search class="size-4" aria-hidden="true" />
              Search
              <kbd class="kbd ml-auto text-[11px] text-fg-subtle" data-search-key>
                Ctrl K
              </kbd>
            </button>
            <div class="mt-6">
              <DocsTree groups={groups} current={current} label={label} />
            </div>
          </div>
        </aside>

        <article class="min-w-0" data-pagefind-body data-pagefind-meta={`kind:${LABEL[kind]}`}>
          <nav class="docs-crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
            <a href={BASE[kind]}>{LABEL[kind]}</a>
            {parent && !isHome && (
              <>
                <ChevronRight class="size-3.5" aria-hidden="true" />
                {parent.href ? (
                  <a href={parent.href}>{parent.title}</a>
                ) : (
                  <span>{parent.title}</span>
                )}
              </>
            )}
          </nav>
          {badge && <p class="docs-badge">{badge}</p>}
          <h1 class={cn('docs-title', code && 'is-code')}>{title}</h1>
          {leadHtml && !hideLead && <p class="docs-lead" set:html={leadHtml} />}

          <div class="prose docs-prose mt-8 max-w-none">
            <slot />
          </div>

          <AdUnit class="mt-16" />

          <nav
            data-pagefind-ignore
            class="mt-16 grid gap-3 border-t border-line pt-8 sm:grid-cols-2"
            aria-label="Neighbouring pages"
          >
            {prev && (
              <a href={prev.href} class="docs-neighbour">
                <span class="flex items-center gap-1 text-xs text-fg-subtle">
                  <ArrowLeft class="size-3.5" aria-hidden="true" /> Previous
                </span>
                <span class={cn('text-sm font-medium', prev.code && 'font-mono')}>
                  {prev.title}
                </span>
              </a>
            )}
            {next && (
              <a href={next.href} class="docs-neighbour text-right sm:col-start-2">
                <span class="flex items-center justify-end gap-1 text-xs text-fg-subtle">
                  Next <ArrowRight class="size-3.5" aria-hidden="true" />
                </span>
                <span class={cn('text-sm font-medium', next.code && 'font-mono')}>
                  {next.title}
                </span>
              </a>
            )}
          </nav>

          {editUrl && (
            <p class="mt-8 text-sm text-fg-subtle" data-pagefind-ignore>
              <a
                href={editUrl}
                class="underline underline-offset-4 transition-colors duration-200 hover:text-accent-ink"
                target="_blank"
                rel="noopener"
              >
                Edit this page on GitHub
              </a>
            </p>
          )}
        </article>

        {toc.length > 1 && (
          <aside class="hidden xl:block">
            <nav class="docs-rail" aria-label="On this page" data-lenis-prevent>
              <p class="docs-tree-heading">On this page</p>
              <ul class="mt-2 space-y-0.5 border-l border-line text-[13px]">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class={cn(
                        '-ml-px block border-l border-transparent py-1 leading-snug text-fg-muted transition-colors duration-200 hover:border-line-strong hover:text-fg',
                        h.depth === 2 ? 'pl-3' : 'pl-6',
                      )}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    </div>
  </main>

  <SearchDialog />
  <Footer />
</Base>

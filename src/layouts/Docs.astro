---
/**
 * A developer docs page across the window's width (`container-wide`, up to 1920px): the
 * section tree on the left (DocsTree, which folds the API reference's methods, commands and
 * types under their index pages), the page in the middle with its prose held to a reading
 * measure, and an "On this page" list on the right from 1280px up that marks the section being
 * read. Below 1024px the tree folds into a disclosure above the page; below 1280px "On this
 * page" is a disclosure under the title. The search dialog (Ctrl+K) covers both collections;
 * Pagefind indexes only the article, so the menus, the footer and the neighbour links stay out
 * of it.
 */
import type { MarkdownHeading } from 'astro';
import { ArrowLeft, ArrowRight, ChevronRight, Search } from '@lucide/astro';
import Base from '@/layouts/Base.astro';
import { article, breadcrumbs, lastModified } from '@/lib/seo';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/components/Search.astro';
import AdUnit from '@/components/AdUnit.astro';
import DocsTree from '@/components/DocsTree.astro';
import { cn } from '@/lib/cn';
import { BASE, LABEL, getNav, type Kind } from '@/lib/docs';

interface Props {
  kind: Kind;
  /** The page's h1. */
  title: string;
  description?: string;
  /** Where the page sits, for the breadcrumb: its sidebar section, or its index page. */
  parent?: { title: string; href?: string };
  /** A reference page's kind: Method, Edit command, Type. */
  badge?: string;
  /** The title is an API name, set in code type. */
  code?: boolean;
  /** The page's path without a trailing slash, as the sidebar links it. */
  current: string;
  headings: MarkdownHeading[];
  editUrl?: string;
  /** The <title> for search results, when the h1 alone says too little. */
  seoTitle?: string;
  /** The description is for search results only: the page's own prose opens with the same. */
  hideLead?: boolean;
}

const {
  kind,
  title,
  description,
  parent,
  badge,
  code,
  current,
  headings,
  editUrl,
  seoTitle,
  hideLead,
} = Astro.props;
const { groups, flat } = await getNav(kind);
const index = flat.findIndex((item) => item.href === current);
const prev = index > 0 ? flat[index - 1] : undefined;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const isHome = current === BASE[kind];
const pageTitle = seoTitle ?? (isHome ? LABEL[kind] : `${title} · ${LABEL[kind]}`);
const path = `${current}/`;
const modified = lastModified(path);
const ld = [
  article({
    site: Astro.site,
    path,
    headline: title,
    description,
    image: '/og.png',
    modified,
    type: 'TechArticle',
  }),
  breadcrumbs(Astro.site, [
    ['Concat', '/'],
    [LABEL[kind], `${BASE[kind]}/`],
    ...(parent?.href ? ([[parent.title, `${parent.href}/`]] as Array<[string, string]>) : []),
    ...(isHome ? [] : ([[title, path]] as Array<[string, string]>)),
  ]),
];
const label = `${LABEL[kind]} pages`;
// A description may name code in backticks: set as code in the lead, plain in search results.
const escapeHtml = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const leadHtml = description
  ? escapeHtml(description).replace(/`([^`]+)`/g, '<code>$1</code>')
  : undefined;
const metaDescription = description?.replace(/`/g, '');
---

<Base
  title={`${pageTitle} · Concat`}
  description={metaDescription}
  type="article"
  modified={modified}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  <Header wide />

  <main class="pt-16">
    <div class="container-wide docs-frame">
      <aside class="docs-side">
        <div class="docs-rail" data-lenis-prevent>
          <button type="button" class="docs-search" data-search-open>
            <Search class="size-[18px]" aria-hidden="true" />
            Search the docs
            <kbd class="kbd ml-auto text-[11px] text-fg-subtle" data-search-key>
              Ctrl K
            </kbd>
          </button>
          <div class="mt-8">
            <DocsTree groups={groups} current={current} label={label} />
          </div>
        </div>
      </aside>

      <div class="docs-main">
        <div class="docs-mobile-nav">
          <button type="button" class="docs-search" data-search-open>
            <Search class="size-[18px]" aria-hidden="true" />
            Search the docs
            <kbd class="kbd ml-auto text-[11px] text-fg-subtle" data-search-key>
              Ctrl K
            </kbd>
          </button>
          <details class="docs-disclosure group/nav">
            <summary>
              <span>{LABEL[kind]} pages</span>
              <ChevronRight
                class="size-5 text-fg-subtle transition-transform duration-300 ease-out-expo group-open/nav:rotate-90"
                aria-hidden="true"
              />
            </summary>
            <div class="docs-disclosure-body">
              <DocsTree groups={groups} current={current} label={label} />
            </div>
          </details>
        </div>

        <article class="docs-article" data-pagefind-body data-pagefind-meta={`kind:${LABEL[kind]}`}>
          <header class="docs-head">
            <nav class="docs-crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
              <a href={BASE[kind]}>{LABEL[kind]}</a>
              {parent && !isHome && (
                <>
                  <ChevronRight class="size-4" aria-hidden="true" />
                  {parent.href ? (
                    <a href={parent.href}>{parent.title}</a>
                  ) : (
                    <span>{parent.title}</span>
                  )}
                </>
              )}
            </nav>
            {badge && <p class="docs-badge">{badge}</p>}
            <h1 class={cn('docs-title', code && 'is-code')}>{title}</h1>
            {leadHtml && !hideLead && <p class="docs-lead" set:html={leadHtml} />}
          </header>

          {toc.length > 1 && (
            <details class="docs-disclosure docs-toc-mobile group/toc" data-pagefind-ignore>
              <summary>
                <span>On this page</span>
                <ChevronRight
                  class="size-5 text-fg-subtle transition-transform duration-300 ease-out-expo group-open/toc:rotate-90"
                  aria-hidden="true"
                />
              </summary>
              <ul class="docs-toc docs-disclosure-body" data-toc>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class={cn('docs-toc-link', h.depth === 3 && 'is-sub')}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}

          <div class="prose docs-prose max-w-none">
            <slot />
          </div>

          <AdUnit class="mt-20" />

          <nav data-pagefind-ignore class="docs-neighbours" aria-label="Neighbouring pages">
            {prev && (
              <a href={prev.href} class="docs-neighbour">
                <span class="docs-neighbour-label">
                  <ArrowLeft class="size-4" aria-hidden="true" /> Previous
                </span>
                <span class={cn('docs-neighbour-title', prev.code && 'is-code')}>{prev.title}</span>
              </a>
            )}
            {next && (
              <a href={next.href} class="docs-neighbour is-next">
                <span class="docs-neighbour-label">
                  Next <ArrowRight class="size-4" aria-hidden="true" />
                </span>
                <span class={cn('docs-neighbour-title', next.code && 'is-code')}>{next.title}</span>
              </a>
            )}
          </nav>

          {editUrl && (
            <p class="mt-10 text-[15px] text-fg-subtle" data-pagefind-ignore>
              <a
                href={editUrl}
                class="underline underline-offset-4 transition-colors duration-200 hover:text-accent-ink"
                target="_blank"
                rel="noopener"
              >
                Edit this page on GitHub
              </a>
            </p>
          )}
        </article>
      </div>

      {toc.length > 1 && (
        <aside class="docs-aside">
          <nav class="docs-rail" aria-label="On this page" data-lenis-prevent>
            <p class="docs-tree-heading">On this page</p>
            <ul class="docs-toc" data-toc>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class={cn('docs-toc-link', h.depth === 3 && 'is-sub')}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </main>

  <SearchDialog />
  <Footer />
</Base>

<script>
  // "On this page" marks the section being read: the last heading whose top has passed under
  // the header bar. Set up on every page load (view transitions) and torn down before a swap.
  let stop: AbortController | undefined;
  const setup = () => {
    stop?.abort();
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc] a'));
    if (!links.length) return;
    stop = new AbortController();
    const ids = [...new Set(links.map((a) => decodeURIComponent(a.hash.slice(1))))];
    const heads = ids.map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
    let frame = 0;
    const update = () => {
      frame = 0;
      let current = heads[0]?.id;
      for (const h of heads) if (h.getBoundingClientRect().top < 140) current = h.id;
      for (const a of links) {
        const on = decodeURIComponent(a.hash.slice(1)) === current;
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true, signal: stop.signal });
    window.addEventListener('resize', queue, { passive: true, signal: stop.signal });
    update();
  };
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => stop?.abort());
</script>

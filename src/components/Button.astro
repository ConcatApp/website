---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/cn';

type Variant = 'primary' | 'secondary' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /** Buttons only; anchors ignore it. */
  disabled?: boolean;
  variant?: Variant;
  size?: Size;
  class?: string;
}

const {
  href,
  type,
  disabled,
  variant = 'primary',
  size = 'md',
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';

const base =
  'inline-flex items-center justify-center gap-2 font-medium whitespace-nowrap select-none ' +
  'transition-[background-color,color,border-color,transform] duration-150 active:translate-y-px ' +
  'disabled:pointer-events-none disabled:opacity-50';

const variants: Record<Variant, string> = {
  // The light pill with dark text: the main action, one per view.
  primary: 'bg-primary text-primary-fg hover:bg-primary-hover',
  // A faint wash inside a hairline.
  secondary: 'border border-line-strong bg-bg-subtle text-fg hover:bg-bg-overlay',
  ghost: 'text-fg-muted hover:text-fg hover:bg-bg-subtle',
};

const sizes: Record<Size, string> = {
  sm: 'h-[34px] rounded-full px-3.5 text-[13px]',
  md: 'h-11 rounded-full px-5 text-[15px] tracking-[-0.01em]',
  lg: 'h-[50px] rounded-[17px] px-5 text-[17px] tracking-[-0.02em]',
};
---

<Tag
  href={href}
  type={href ? undefined : (type ?? 'button')}
  disabled={href ? undefined : disabled}
  class={cn(base, variants[variant], sizes[size], className)}
  {...rest}
>
  <slot />
</Tag>

---
/**
 * A plain bar along the top of the page, after meltkit.com: the page colour, blurred, with a
 * hairline under it. The mark and the name are the home link; three dropdown menus (Learn, Free
 * tools, Community) follow it on wide screens. On a pointer device a menu opens on hover; a
 * click (or Enter on the trigger) toggles it for touch and keyboard users, and Escape, an outside
 * click or focus leaving the menu closes it. Below the md breakpoint the menus fold into a sheet
 * behind the menu button.
 */
import { siDiscord, siGithub, siX } from 'simple-icons';
import {
  BookOpen,
  Braces,
  ChevronDown,
  Heart,
  Mail,
  Menu,
  Newspaper,
  Wrench,
  X,
} from '@lucide/astro';
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import mark from '@/assets/mark.png';
import GuideIcon from '@/components/GuideIcon.astro';
import { DISCORD_URL, REPO_URL, X_URL } from '@/lib/releases';
import { TOOLS, toolHref } from '@/lib/tools';
import type { GuideIcon as GuideIconName } from '@/lib/guide-icons';
import { cn } from '@/lib/cn';

interface Props {
  /** Span the window, as the developer docs do, instead of the 1080px content column. */
  wide?: boolean;
}

const { wide = false } = Astro.props;

interface Item {
  href: string;
  label: string;
  hint: string;
  /** A Lucide component, or a Simple Icons path for a brand mark. */
  icon?: typeof BookOpen;
  /** A guide or tool icon name (src/lib/guide-icons.ts). */
  named?: GuideIconName;
  brand?: string;
  external?: boolean;
}

const menus: Array<{ label: string; items: Item[] }> = [
  {
    label: 'Learn',
    items: [
      {
        href: '/guides',
        label: 'Guides',
        hint: 'Where everything is, step by step',
        icon: BookOpen,
      },
      { href: '/docs', label: 'Developer docs', hint: 'The API, JSON-RPC and gRPC', icon: Braces },
      { href: '/blog', label: 'Blog', hint: 'What changed, and why', icon: Newspaper },
    ],
  },
  {
    label: 'Free tools',
    items: [
      ...TOOLS.filter((t) => t.group === 'Video').map((t) => ({
        href: toolHref(t),
        label: t.title,
        hint: t.lead,
        named: t.icon,
      })),
      {
        href: '/tools',
        label: 'All free tools',
        hint: 'Scripts, subtitles and calculators too',
        icon: Wrench,
      },
    ],
  },
  {
    label: 'Community',
    items: [
      {
        href: '/#sponsor',
        label: 'Sponsor',
        hint: 'Your logo on the repository and here',
        icon: Heart,
      },
      { href: '/#contact', label: 'Contact', hint: 'Discord and email', icon: Mail },
      {
        href: REPO_URL,
        label: 'GitHub',
        hint: 'Source, issues and releases',
        brand: siGithub.path,
        external: true,
      },
      {
        href: DISCORD_URL,
        label: 'Discord',
        hint: 'Join the server',
        brand: siDiscord.path,
        external: true,
      },
      {
        href: X_URL,
        label: 'X',
        hint: 'News and releases',
        brand: siX.path,
        external: true,
      },
    ],
  },
];
---

<header class="glass fixed inset-x-0 top-0 z-40" data-header>
  <nav
    class={cn(
      wide ? 'container-wide' : 'container-x',
      'flex h-16 items-center justify-between gap-4',
    )}
    aria-label="Main"
  >
    <div class="flex items-center gap-6">
      <a href="/" aria-label="Concat home" class="flex items-center gap-2.5">
        <Image
          src={mark}
          alt=""
          width={56}
          height={56}
          loading="eager"
          class="size-7 rounded-[18.5%] ring-1 ring-white/12"
        />
        <span class="text-[15px] font-medium tracking-[-0.01em] max-sm:sr-only">Concat</span>
      </a>

      <ul class="hidden items-center gap-0.5 md:flex">
        {menus.map((menu) => (
          <li class="group relative" data-menu>
            <button
              type="button"
              class="flex h-9 items-center gap-1 rounded-full px-3 text-[14px] text-fg-muted transition-colors duration-150 group-hover:text-fg group-data-[open]:text-fg"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {menu.label}
              <ChevronDown
                class="size-3.5 transition-transform duration-200 ease-out-expo group-hover:rotate-180 group-data-[open]:rotate-180"
                aria-hidden="true"
              />
            </button>
            <div class="absolute top-full left-0 hidden pt-3 group-hover:block group-data-[open]:block">
              <ul class="card w-72 rounded-[22px] p-1.5 shadow-frame ring-1 ring-line">
                {menu.items.map(({ icon: Icon, ...item }) => (
                  <li>
                    <a
                      href={item.href}
                      class="group/item flex items-start gap-3 rounded-[16px] px-3 py-2.5 transition-colors duration-150 hover:bg-bg-subtle"
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener' : undefined}
                    >
                      <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-bg-overlay text-fg">
                        {Icon && <Icon class="size-4" aria-hidden="true" />}
                        {item.named && <GuideIcon name={item.named} class="size-4" />}
                        {item.brand && (
                          <svg
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                            class="size-4"
                          >
                            <path d={item.brand} />
                          </svg>
                        )}
                      </span>
                      <span class="min-w-0">
                        <span class="block text-sm font-medium">{item.label}</span>
                        <span class="mt-0.5 block text-xs text-fg-muted">{item.hint}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-1">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener"
        aria-label="Concat on GitHub"
        class="flex size-9 items-center justify-center rounded-full text-fg-muted transition-colors duration-150 hover:text-fg max-sm:hidden"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]">
          <path d={siGithub.path}></path>
        </svg>
      </a>
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener"
        aria-label="Concat on Discord"
        class="flex size-9 items-center justify-center rounded-full text-fg-muted transition-colors duration-150 hover:text-fg max-sm:hidden"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]">
          <path d={siDiscord.path}></path>
        </svg>
      </a>
      <a
        href={X_URL}
        target="_blank"
        rel="noopener"
        aria-label="Concat on X"
        class="flex size-9 items-center justify-center rounded-full text-fg-muted transition-colors duration-150 hover:text-fg max-sm:hidden"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4">
          <path d={siX.path}></path>
        </svg>
      </a>
      <Button href="/#download" size="sm" class="ml-2">
        Download
      </Button>
      <button
        type="button"
        class="flex size-10 items-center justify-center rounded-full text-fg-muted transition-colors duration-150 hover:bg-bg-subtle hover:text-fg md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Menu class="size-5" data-icon-open aria-hidden="true" />
        <X class="hidden size-5" data-icon-close aria-hidden="true" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="card mx-3 mb-3 hidden rounded-[22px] p-2 md:hidden" data-mobile-menu>
    {menus.map((menu) => (
      <div class="p-2">
        <p class="px-2 pb-1 text-xs font-medium text-fg-subtle">{menu.label}</p>
        <ul>
          {menu.items.map(({ icon: Icon, ...item }) => (
            <li>
              <a
                href={item.href}
                class="flex items-center gap-3 rounded-[14px] px-2 py-2 text-[15px] font-medium hover:bg-bg-subtle"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                <span class="flex size-7 items-center justify-center rounded-full bg-bg-overlay text-fg">
                  {Icon && <Icon class="size-3.5" aria-hidden="true" />}
                  {item.named && <GuideIcon name={item.named} class="size-3.5" />}
                  {item.brand && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                      class="size-3.5"
                    >
                      <path d={item.brand} />
                    </svg>
                  )}
                </span>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</header>

<script>
  const menusOnPage = () => Array.from(document.querySelectorAll<HTMLElement>('[data-menu]'));

  function setOpen(menu: HTMLElement, open: boolean) {
    if (open) menu.dataset.open = '';
    else delete menu.dataset.open;
    menu.querySelector('button')?.setAttribute('aria-expanded', String(open));
  }

  function closeAll(except?: HTMLElement) {
    for (const menu of menusOnPage()) if (menu !== except) setOpen(menu, false);
  }

  function setMobile(open: boolean) {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const sheet = document.querySelector<HTMLElement>('[data-mobile-menu]');
    if (!toggle || !sheet) return;
    sheet.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
  }

  // Document-level listeners are registered once; the menus they act on are looked up live, so
  // they survive Astro's client-side navigation without piling up.
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (!menusOnPage().some((menu) => menu.contains(target))) closeAll();
    const header = document.querySelector('[data-header]');
    if (header && !header.contains(target)) setMobile(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeAll();
      setMobile(false);
    }
  });

  document.addEventListener('astro:page-load', () => {
    for (const menu of menusOnPage()) {
      const button = menu.querySelector('button');
      if (!button) continue;
      button.addEventListener('click', () => {
        const open = menu.dataset.open !== undefined;
        closeAll(menu);
        setOpen(menu, !open);
      });
      menu.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (!next || !menu.contains(next)) setOpen(menu, false);
      });
      // A link click inside the menu (same-page anchors included) should close it.
      menu.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setOpen(menu, false);
      });
    }
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    toggle?.addEventListener('click', () => {
      setMobile(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.querySelector('[data-mobile-menu]')?.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setMobile(false);
    });
  });
</script>

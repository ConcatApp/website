---
/**
 * Fixed header with three dropdown menus. On a pointer device a menu opens on hover; a click (or
 * Enter on the trigger) toggles it for touch and keyboard users, and Escape, an outside click or
 * focus leaving the menu closes it. The mark alone is the home link and the menus sit right
 * after it; below the md breakpoint only the mark, the GitHub and Discord icons and the Download
 * button show.
 */
import { siDiscord, siGithub } from 'simple-icons';
import {
  BookOpen,
  Braces,
  ChevronDown,
  CircleHelp,
  Download,
  Heart,
  Mail,
  Milestone,
  Sparkles,
} from '@lucide/astro';
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import Mark from '@/assets/mark.svg';
import { DISCORD_URL, REPO_URL } from '@/lib/releases';

interface Item {
  href: string;
  label: string;
  hint: string;
  /** A Lucide component, or a Simple Icons path for a brand mark. */
  icon?: typeof Download;
  brand?: string;
  external?: boolean;
}

const menus: Array<{ label: string; items: Item[] }> = [
  {
    label: 'Product',
    items: [
      {
        href: '/#features',
        label: 'Features',
        hint: 'Captions, voices, titles and effects',
        icon: Sparkles,
      },
      {
        href: '/#download',
        label: 'Download',
        hint: 'Every platform, from GitHub Releases',
        icon: Download,
      },
      {
        href: '/roadmap',
        label: 'Roadmap',
        hint: 'What comes next and what it costs',
        icon: Milestone,
      },
    ],
  },
  {
    label: 'Learn',
    items: [
      {
        href: '/guides',
        label: 'Guides',
        hint: 'Install, requirements and models',
        icon: BookOpen,
      },
      { href: '/docs', label: 'Developer docs', hint: 'JSON-RPC, gRPC and MCP', icon: Braces },
      { href: '/#faq', label: 'FAQ', hint: 'Common questions', icon: CircleHelp },
    ],
  },
  {
    label: 'Community',
    items: [
      {
        href: '/#sponsor',
        label: 'Sponsor',
        hint: 'Monthly tiers, listed on the repository',
        icon: Heart,
      },
      { href: '/#contact', label: 'Contact', hint: 'Discord and email', icon: Mail },
      {
        href: REPO_URL,
        label: 'GitHub',
        hint: 'Source, issues and releases',
        brand: siGithub.path,
        external: true,
      },
      {
        href: DISCORD_URL,
        label: 'Discord',
        hint: 'Join the server',
        brand: siDiscord.path,
        external: true,
      },
    ],
  },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <Container as="nav" class="flex h-16 items-center justify-between" aria-label="Main">
    <div class="flex items-center gap-4">
      <a href="/" aria-label="Concat home" class="flex items-center">
        <Mark class="size-7" aria-hidden="true" />
      </a>

      <ul class="hidden items-center gap-1 md:flex">
        {menus.map((menu) => (
          <li class="group relative" data-menu>
            <button
              type="button"
              class="flex h-9 items-center gap-1 rounded-md px-3 text-[0.9375rem] font-medium text-fg-muted transition-colors duration-200 group-hover:text-fg group-data-[open]:bg-bg-subtle group-data-[open]:text-fg hover:bg-bg-subtle"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {menu.label}
              <ChevronDown
                class="size-3.5 transition-transform duration-200 ease-out-expo group-hover:rotate-180 group-data-[open]:rotate-180"
                aria-hidden="true"
              />
            </button>
            <div class="absolute top-full left-0 hidden pt-2 group-hover:block group-data-[open]:block">
              <ul class="w-72 rounded-lg border border-line-strong bg-bg p-1.5">
                {menu.items.map(({ icon: Icon, ...item }) => (
                  <li>
                    <a
                      href={item.href}
                      class="group/item flex items-start gap-3 rounded-md px-3 py-2 transition-colors duration-200 hover:bg-bg-subtle"
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener' : undefined}
                    >
                      <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-line bg-bg-subtle text-fg-muted transition-colors duration-200 group-hover/item:text-fg">
                        {Icon && <Icon class="size-4" aria-hidden="true" />}
                        {item.brand && (
                          <svg
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                            class="size-4"
                          >
                            <path d={item.brand} />
                          </svg>
                        )}
                      </span>
                      <span class="min-w-0">
                        <span class="block text-sm font-medium">{item.label}</span>
                        <span class="mt-0.5 block text-xs text-fg-muted">{item.hint}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-4">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener"
        aria-label="Concat on GitHub"
        class="text-fg-muted transition-colors duration-200 hover:text-fg"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5">
          <path d={siGithub.path}></path>
        </svg>
      </a>
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener"
        aria-label="Concat on Discord"
        class="text-fg-muted transition-colors duration-200 hover:text-fg"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5">
          <path d={siDiscord.path}></path>
        </svg>
      </a>
      <Button href="/#download" size="sm">
        Download
      </Button>
    </div>
  </Container>
</header>

<script>
  const menusOnPage = () => Array.from(document.querySelectorAll<HTMLElement>('[data-menu]'));

  function setOpen(menu: HTMLElement, open: boolean) {
    if (open) menu.dataset.open = '';
    else delete menu.dataset.open;
    menu.querySelector('button')?.setAttribute('aria-expanded', String(open));
  }

  function closeAll(except?: HTMLElement) {
    for (const menu of menusOnPage()) if (menu !== except) setOpen(menu, false);
  }

  // Document-level listeners are registered once; the menus they act on are looked up live, so
  // they survive Astro's client-side navigation without piling up.
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (!menusOnPage().some((menu) => menu.contains(target))) closeAll();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });

  document.addEventListener('astro:page-load', () => {
    for (const menu of menusOnPage()) {
      const button = menu.querySelector('button');
      if (!button) continue;
      button.addEventListener('click', () => {
        const open = menu.dataset.open !== undefined;
        closeAll(menu);
        setOpen(menu, !open);
      });
      menu.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (!next || !menu.contains(next)) setOpen(menu, false);
      });
      // A link click inside the menu (same-page anchors included) should close it.
      menu.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setOpen(menu, false);
      });
    }
  });
</script>

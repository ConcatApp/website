---
/**
 * Floating glass bar over the page. The mark is the home link; three dropdown menus (Product,
 * Learn, Community) follow it on wide screens. On a pointer device a menu opens on hover; a
 * click (or Enter on the trigger) toggles it for touch and keyboard users, and Escape, an outside
 * click or focus leaving the menu closes it. Below the md breakpoint the menus fold into a sheet
 * behind the menu button.
 */
import { siDiscord, siGithub } from 'simple-icons';
import {
  BookOpen,
  Braces,
  ChevronDown,
  CircleHelp,
  Download,
  Heart,
  Mail,
  Menu,
  Milestone,
  Sparkles,
  X,
} from '@lucide/astro';
import Button from '@/components/Button.astro';
import Mark from '@/assets/mark.svg';
import { DISCORD_URL, REPO_URL } from '@/lib/releases';

interface Item {
  href: string;
  label: string;
  hint: string;
  /** A Lucide component, or a Simple Icons path for a brand mark. */
  icon?: typeof Download;
  brand?: string;
  external?: boolean;
}

const menus: Array<{ label: string; items: Item[] }> = [
  {
    label: 'Product',
    items: [
      {
        href: '/#features',
        label: 'Features',
        hint: 'Captions, voices, titles and effects',
        icon: Sparkles,
      },
      {
        href: '/#download',
        label: 'Download',
        hint: 'Every platform, from GitHub Releases',
        icon: Download,
      },
      {
        href: '/roadmap',
        label: 'Roadmap',
        hint: 'What comes next and what it costs',
        icon: Milestone,
      },
    ],
  },
  {
    label: 'Learn',
    items: [
      {
        href: '/guides',
        label: 'Guides',
        hint: 'Where everything is, step by step',
        icon: BookOpen,
      },
      { href: '/docs', label: 'Developer docs', hint: 'JSON-RPC, gRPC and MCP', icon: Braces },
      { href: '/#faq', label: 'FAQ', hint: 'Common questions', icon: CircleHelp },
    ],
  },
  {
    label: 'Community',
    items: [
      {
        href: '/#sponsor',
        label: 'Sponsor',
        hint: 'Your logo on the repository and here',
        icon: Heart,
      },
      { href: '/#contact', label: 'Contact', hint: 'Discord and email', icon: Mail },
      {
        href: REPO_URL,
        label: 'GitHub',
        hint: 'Source, issues and releases',
        brand: siGithub.path,
        external: true,
      },
      {
        href: DISCORD_URL,
        label: 'Discord',
        hint: 'Join the server',
        brand: siDiscord.path,
        external: true,
      },
    ],
  },
];
---

<header class="fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-5 sm:pt-4" data-header>
  <nav
    class="glass mx-auto flex h-14 max-w-[1100px] items-center justify-between gap-4 rounded-[18px] pr-2 pl-4 sm:pl-5"
    aria-label="Main"
  >
    <div class="flex items-center gap-5">
      <a href="/" aria-label="Concat home" class="flex items-center gap-2.5">
        <Mark class="size-7" aria-hidden="true" />
        <span class="text-[0.9375rem] font-semibold tracking-tight max-sm:sr-only">Concat</span>
      </a>

      <ul class="hidden items-center gap-0.5 md:flex">
        {menus.map((menu) => (
          <li class="group relative" data-menu>
            <button
              type="button"
              class="flex h-9 items-center gap-1 rounded-full px-3 text-[14px] font-medium text-fg-muted transition-colors duration-200 group-hover:text-fg group-data-[open]:bg-bg-subtle group-data-[open]:text-fg hover:bg-bg-subtle"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {menu.label}
              <ChevronDown
                class="size-3.5 transition-transform duration-200 ease-out-expo group-hover:rotate-180 group-data-[open]:rotate-180"
                aria-hidden="true"
              />
            </button>
            <div class="absolute top-full left-0 hidden pt-3 group-hover:block group-data-[open]:block">
              <ul class="card-glass w-72 rounded-xl p-1.5">
                {menu.items.map(({ icon: Icon, ...item }) => (
                  <li>
                    <a
                      href={item.href}
                      class="group/item flex items-start gap-3 rounded-lg px-3 py-2 transition-colors duration-200 hover:bg-bg-subtle"
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noopener' : undefined}
                    >
                      <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent-ink">
                        {Icon && <Icon class="size-4" aria-hidden="true" />}
                        {item.brand && (
                          <svg
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                            class="size-4"
                          >
                            <path d={item.brand} />
                          </svg>
                        )}
                      </span>
                      <span class="min-w-0">
                        <span class="block text-sm font-medium">{item.label}</span>
                        <span class="mt-0.5 block text-xs text-fg-muted">{item.hint}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center gap-1">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener"
        aria-label="Concat on GitHub"
        class="flex size-9 items-center justify-center rounded-full text-fg-muted transition-colors duration-200 hover:bg-bg-subtle hover:text-fg max-sm:hidden"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]">
          <path d={siGithub.path}></path>
        </svg>
      </a>
      <a
        href={DISCORD_URL}
        target="_blank"
        rel="noopener"
        aria-label="Concat on Discord"
        class="flex size-9 items-center justify-center rounded-full text-fg-muted transition-colors duration-200 hover:bg-bg-subtle hover:text-fg max-sm:hidden"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]">
          <path d={siDiscord.path}></path>
        </svg>
      </a>
      <Button href="/#download" size="sm" class="ml-1 h-10 rounded-[12px] px-5">
        Download
      </Button>
      <button
        type="button"
        class="flex size-10 items-center justify-center rounded-[12px] text-fg-muted transition-colors duration-200 hover:bg-bg-subtle hover:text-fg md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Menu class="size-5" data-icon-open aria-hidden="true" />
        <X class="hidden size-5" data-icon-close aria-hidden="true" />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="card-glass mx-auto mt-2 hidden max-w-[1100px] rounded-[18px] p-2 md:hidden"
    data-mobile-menu
  >
    {menus.map((menu) => (
      <div class="p-2">
        <p class="px-2 pb-1 text-xs font-semibold tracking-wide text-fg-subtle uppercase">
          {menu.label}
        </p>
        <ul>
          {menu.items.map(({ icon: Icon, ...item }) => (
            <li>
              <a
                href={item.href}
                class="flex items-center gap-3 rounded-lg px-2 py-2 text-[0.9375rem] font-medium hover:bg-bg-subtle"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                <span class="flex size-7 items-center justify-center rounded-full bg-accent-soft text-accent-ink">
                  {Icon && <Icon class="size-3.5" aria-hidden="true" />}
                  {item.brand && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                      class="size-3.5"
                    >
                      <path d={item.brand} />
                    </svg>
                  )}
                </span>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</header>

<script>
  const menusOnPage = () => Array.from(document.querySelectorAll<HTMLElement>('[data-menu]'));

  function setOpen(menu: HTMLElement, open: boolean) {
    if (open) menu.dataset.open = '';
    else delete menu.dataset.open;
    menu.querySelector('button')?.setAttribute('aria-expanded', String(open));
  }

  function closeAll(except?: HTMLElement) {
    for (const menu of menusOnPage()) if (menu !== except) setOpen(menu, false);
  }

  function setMobile(open: boolean) {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const sheet = document.querySelector<HTMLElement>('[data-mobile-menu]');
    if (!toggle || !sheet) return;
    sheet.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
  }

  // Document-level listeners are registered once; the menus they act on are looked up live, so
  // they survive Astro's client-side navigation without piling up.
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (!menusOnPage().some((menu) => menu.contains(target))) closeAll();
    const header = document.querySelector('[data-header]');
    if (header && !header.contains(target)) setMobile(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeAll();
      setMobile(false);
    }
  });

  document.addEventListener('astro:page-load', () => {
    for (const menu of menusOnPage()) {
      const button = menu.querySelector('button');
      if (!button) continue;
      button.addEventListener('click', () => {
        const open = menu.dataset.open !== undefined;
        closeAll(menu);
        setOpen(menu, !open);
      });
      menu.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (!next || !menu.contains(next)) setOpen(menu, false);
      });
      // A link click inside the menu (same-page anchors included) should close it.
      menu.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setOpen(menu, false);
      });
    }
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    toggle?.addEventListener('click', () => {
      setMobile(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.querySelector('[data-mobile-menu]')?.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setMobile(false);
    });
  });
</script>

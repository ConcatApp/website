---
/**
 * Fixed header with three dropdown menus. On a pointer device a menu opens on hover; a click (or
 * Enter on the trigger) toggles it for touch and keyboard users, and Escape, an outside click or
 * focus leaving the menu closes it. Below the md breakpoint only the wordmark, the GitHub link
 * and the Download button show.
 */
import { siGithub } from 'simple-icons';
import { ChevronDown } from '@lucide/astro';
import Container from '@/components/Container.astro';
import Button from '@/components/Button.astro';
import { DISCORD_URL, REPO_URL } from '@/lib/releases';

interface Item {
  href: string;
  label: string;
  hint: string;
  external?: boolean;
}

const menus: Array<{ label: string; items: Item[] }> = [
  {
    label: 'Product',
    items: [
      { href: '/#features', label: 'Features', hint: 'Captions, voices, titles and effects' },
      { href: '/#download', label: 'Download', hint: 'Every platform, from GitHub Releases' },
      { href: '/roadmap', label: 'Roadmap', hint: 'What comes next and what it costs' },
    ],
  },
  {
    label: 'Learn',
    items: [
      { href: '/guides', label: 'Guides', hint: 'Install, requirements and models' },
      { href: '/docs', label: 'Developer docs', hint: 'JSON-RPC, gRPC and MCP' },
      { href: '/#faq', label: 'FAQ', hint: 'Common questions' },
    ],
  },
  {
    label: 'Community',
    items: [
      { href: '/#sponsor', label: 'Sponsor', hint: 'Monthly tiers, listed on the repository' },
      { href: '/#contact', label: 'Contact', hint: 'Discord and email' },
      { href: REPO_URL, label: 'GitHub', hint: 'Source, issues and releases', external: true },
      { href: DISCORD_URL, label: 'Discord', hint: 'Join the server', external: true },
    ],
  },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <Container as="nav" class="flex h-16 items-center justify-between" aria-label="Main">
    <a href="/" class="text-[0.9375rem] font-semibold">
      Concat
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {menus.map((menu) => (
        <li class="group relative" data-menu>
          <button
            type="button"
            class="flex h-9 items-center gap-1 rounded-md px-3 text-sm text-fg-muted transition-colors duration-200 group-hover:text-fg group-data-[open]:bg-bg-subtle group-data-[open]:text-fg hover:bg-bg-subtle"
            aria-haspopup="true"
            aria-expanded="false"
          >
            {menu.label}
            <ChevronDown
              class="size-3.5 transition-transform duration-200 ease-out-expo group-hover:rotate-180 group-data-[open]:rotate-180"
              aria-hidden="true"
            />
          </button>
          <div class="absolute top-full left-0 hidden pt-2 group-hover:block group-data-[open]:block">
            <ul class="w-64 rounded-lg border border-line-strong bg-bg p-1.5">
              {menu.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="block rounded-md px-3 py-2 transition-colors duration-200 hover:bg-bg-subtle"
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener' : undefined}
                  >
                    <span class="block text-sm font-medium">{item.label}</span>
                    <span class="mt-0.5 block text-xs text-fg-muted">{item.hint}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-4">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener"
        aria-label="Concat on GitHub"
        class="text-fg-muted transition-colors duration-200 hover:text-fg"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5">
          <path d={siGithub.path}></path>
        </svg>
      </a>
      <Button href="/#download" size="sm">
        Download
      </Button>
    </div>
  </Container>
</header>

<script>
  const menusOnPage = () => Array.from(document.querySelectorAll<HTMLElement>('[data-menu]'));

  function setOpen(menu: HTMLElement, open: boolean) {
    if (open) menu.dataset.open = '';
    else delete menu.dataset.open;
    menu.querySelector('button')?.setAttribute('aria-expanded', String(open));
  }

  function closeAll(except?: HTMLElement) {
    for (const menu of menusOnPage()) if (menu !== except) setOpen(menu, false);
  }

  // Document-level listeners are registered once; the menus they act on are looked up live, so
  // they survive Astro's client-side navigation without piling up.
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    if (!menusOnPage().some((menu) => menu.contains(target))) closeAll();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });

  document.addEventListener('astro:page-load', () => {
    for (const menu of menusOnPage()) {
      const button = menu.querySelector('button');
      if (!button) continue;
      button.addEventListener('click', () => {
        const open = menu.dataset.open !== undefined;
        closeAll(menu);
        setOpen(menu, !open);
      });
      menu.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (!next || !menu.contains(next)) setOpen(menu, false);
      });
      // A link click inside the menu (same-page anchors included) should close it.
      menu.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setOpen(menu, false);
      });
    }
  });
</script>

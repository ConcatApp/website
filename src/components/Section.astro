---
/**
 * A page section: the content column 80px under the section before it, and an optional head.
 * The head is centred by default, after meltkit.com: a title (a "\n" in it is a line break), and
 * a short muted line under it. No rules or bands: the cards carry the depth.
 */
import { cn } from '@/lib/cn';

interface Props {
  id?: string;
  title?: string;
  lead?: string;
  align?: 'start' | 'center';
  class?: string;
  /** Classes for the padded column, e.g. to tighten the vertical rhythm. */
  bodyClass?: string;
  /** Classes for the head block. */
  headerClass?: string;
}

const { id, title, lead, align = 'center', class: className, bodyClass, headerClass } = Astro.props;
const lines = title?.split('\n') ?? [];
---

<section id={id} class={cn('scroll-mt-20', className)}>
  <div class={cn('container-x section-y', bodyClass)}>
    {(title || lead) && (
      <header
        class={cn(
          'mb-12 grid gap-4',
          align === 'center' ? 'justify-items-center text-center' : 'max-w-2xl',
          headerClass,
        )}
        data-reveal
      >
        {title && (
          <h2 class="text-display-sm">
            {lines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </h2>
        )}
        {lead && (
          <p
            class={cn(
              'text-lead text-fg-muted',
              align === 'center' ? 'max-w-[26rem] text-balance' : 'max-w-xl',
            )}
          >
            {lead}
          </p>
        )}
      </header>
    )}
    <slot />
  </div>
</section>

---
/**
 * OS-detected call to action. The server renders a safe default (Windows x64); a small script
 * relabels and repoints every instance on the page to the visitor's platform and, where
 * detectable, architecture using the JSON map below. Every link is a GitHub Releases asset.
 */
import Button from '@/components/Button.astro';
import { Download } from '@lucide/astro';
import { formatBytes, type PlatformModel } from '@/lib/releases';

interface Props {
  platforms: PlatformModel[];
  /** `inverse` is the white button on the accent block. */
  variant?: 'primary' | 'inverse';
  /** Show the secondary "All platforms" link next to it. */
  all?: boolean;
  class?: string;
}

const { platforms, variant = 'primary', all = true, class: className } = Astro.props;

type Entry = { url: string; size: string };
const map = Object.fromEntries(
  platforms.map((p) => [
    p.id,
    {
      name: p.name,
      defaultArch: p.arches[0]!.id,
      arches: Object.fromEntries(
        p.arches.map((a) => {
          const f = a.formats[0]!;
          return [a.id, { url: f.binary.url, size: formatBytes(f.binary.bytes) } satisfies Entry];
        }),
      ),
    },
  ]),
);
const initial = map.windows ?? Object.values(map)[0];
const initialFile = initial ? initial.arches[initial.defaultArch] : undefined;
---

<div class:list={['flex flex-wrap items-center gap-3', className]} data-download>
  <Button href={initialFile?.url ?? '#download'} size="lg" variant={variant} data-download-primary>
    <Download class="size-[18px]" aria-hidden="true" />
    <span data-download-label>Download{initial ? ` for ${initial.name}` : ''}</span>
  </Button>
  {all && (
    <Button
      href="#download"
      variant={variant === 'inverse' ? 'outline-inverse' : 'secondary'}
      size="lg"
    >
      All platforms
    </Button>
  )}
  <script type="application/json" data-download-map set:html={JSON.stringify(map)}></script>
</div>

<script>
  import { detectArch, detectPlatform } from '@/scripts/platform';

  type Entry = { url: string; size: string };
  type Platform = { name: string; defaultArch: string; arches: Record<string, Entry> };

  async function apply(root: HTMLElement) {
    const data = root.querySelector('[data-download-map]');
    const button = root.querySelector<HTMLAnchorElement>('[data-download-primary]');
    if (!data || !button) return;

    const map = JSON.parse(data.textContent || '{}') as Record<string, Platform>;
    const os = detectPlatform();
    const platform = map[os];
    if (!platform) return;

    const label = button.querySelector('[data-download-label]');
    const point = (arch: string) => {
      const file = platform.arches[arch] ?? platform.arches[platform.defaultArch];
      if (!file) return;
      button.href = file.url;
      if (label) label.textContent = `Download for ${platform.name}`;
    };

    point(platform.defaultArch);
    const arch = await detectArch(os);
    if (arch) point(arch);
  }

  document.addEventListener('astro:page-load', () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-download]')) void apply(root);
  });
</script>

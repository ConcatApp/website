---
/**
 * A screenshot in a guide: the image in a framed tile with a caption under it. In a guide it
 * steps out of the reading column to the wide measure (`.guide-prose` in global.css). Used from MDX:
 *   import Figure from '@/components/Figure.astro';
 *   import shot from '@/assets/guides/captions-sheet.png';
 *   <Figure src={shot} alt="The Captions sheet">The sheet, with Base (English) picked.</Figure>
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Narrower figures (a crop of one control) sit at this max width instead of the wide measure. */
  width?: string;
}
const { src, alt, width } = Astro.props;
---

<figure
  class="not-prose my-8"
  style={width ? `max-width: ${width}; --figure-w: ${width}` : undefined}
>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280, 1600]}
    sizes="(min-width: 1080px) 960px, 100vw"
    class="block h-auto w-full rounded-[14px] border border-line-strong shadow-card"
  />
  {Astro.slots.has('default') && (
    <figcaption class="mt-3 text-sm leading-relaxed text-fg-muted">
      <slot />
    </figcaption>
  )}
</figure>

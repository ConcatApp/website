---
import { getCollection, render } from 'astro:content';
import Docs from '@/layouts/Docs.astro';
import Api from '@/components/Api.astro';
import ApiIndex from '@/components/ApiIndex.astro';
import ApiErrors from '@/components/ApiErrors.astro';
import { FOLDER, groupsOf, type PagedKind } from '@/lib/api';
import { hrefFor } from '@/lib/docs';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// An API index page lists its groups as h2s the Markdown does not know of; the "On this page"
// list leads with them.
const listed = (Object.keys(FOLDER) as PagedKind[]).find((k) => entry.id === `api/${FOLDER[k]}`);
const groupSlug = (title: string) => `group-${title.toLowerCase().replace(/[^\w]+/g, '-')}`;
const toc = listed
  ? [
      ...groupsOf(listed).map((g) => ({ depth: 2, slug: groupSlug(g.title), text: g.title })),
      ...headings,
    ]
  : headings;
const editUrl = entry.filePath
  ? `https://github.com/ConcatApp/website/edit/main/${entry.filePath}`
  : undefined;
---

<Docs
  kind="docs"
  title={entry.data.title}
  description={entry.data.description}
  parent={entry.id === 'index' ? undefined : { title: entry.data.section }}
  current={hrefFor('docs', entry.id)}
  headings={toc}
  editUrl={editUrl}
>
  <Content components={{ Api, ApiIndex, ApiErrors }} />
</Docs>

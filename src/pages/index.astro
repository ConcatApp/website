---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import DownloadButton from '@/components/DownloadButton.astro';
import Downloader from '@/components/Downloader.astro';
import Button from '@/components/Button.astro';
import {
  AudioWaveform,
  Captions,
  Check,
  LayoutTemplate,
  Layers,
  Mail,
  Mic,
  Type,
} from '@lucide/astro';
import { siDiscord } from 'simple-icons';
import {
  CHECKSUMS_URL,
  DISCORD_URL,
  RELEASES_URL,
  REPO_URL,
  getManifest,
  getPlatforms,
} from '@/lib/releases';
import { SPONSOR_TIERS, formatPrice } from '@/lib/sponsor';
import { CONTACT_EMAIL } from '@/lib/contact';
import { cn } from '@/lib/cn';

const { manifest } = await getManifest();
const platforms = getPlatforms(manifest);

const features = [
  {
    icon: Layers,
    title: 'Multi-track editing',
    body: 'Several timelines per project. Split, trim, merge, transitions and speed control.',
  },
  {
    icon: Captions,
    title: 'Auto-captions, offline',
    body: 'Transcribed on your machine. Nothing is uploaded.',
  },
  { icon: Mic, title: 'Text-to-speech', body: 'Free, local voices. No credits, no cloud.' },
  { icon: AudioWaveform, title: 'Voice filters', body: 'Clean up a recording or play with it.' },
  {
    icon: Type,
    title: 'Titles and styled text',
    body: 'Type, style and animate text on any track.',
  },
  { icon: LayoutTemplate, title: 'Templates', body: 'Build an edit once and reuse it.' },
];

const principles = [
  { title: 'No watermarks', body: 'Exports are yours, at full quality.' },
  { title: 'No account', body: 'Install it and start cutting.' },
  { title: '100% local', body: 'A native Rust engine. Nothing leaves your machine.' },
];
---

<Base title="Concat">
  <Header />

  <main>
    <section class="relative pt-40 pb-24 md:pt-52 md:pb-32">
      <Container class="flex flex-col items-center text-center">
        <h1 class="text-display max-w-5xl" data-reveal>
          The free, <span class="text-accent whitespace-nowrap">open-source</span> CapCut
          replacement.
        </h1>
        <p class="text-lead mt-6 max-w-xl text-fg-muted" data-reveal>
          Concat runs entirely on your machine. No watermarks, no account, no subscription. The same
          app on desktop and mobile.
        </p>
        <div class="mt-10" data-reveal>
          <DownloadButton platforms={platforms} version={manifest.version} />
        </div>
        <!--
          Product visuals are parked for now. When they come back, DeviceFrames.astro takes the
          cropped editor screenshot (src/assets/editor-dark.png) in its `desktop` slot and a mobile
          screenshot in its `phone` slot; see git history for the previous markup.
        -->
      </Container>
    </section>

    <Section id="features" title="Everything you use CapCut for." class="border-t border-line">
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
        {features.map(({ icon: Icon, title, body }) => (
          <article class="hairline rounded-xl border border-line bg-bg-raised p-7">
            <Icon class="size-5 text-accent" aria-hidden="true" />
            <h3 class="mt-6 text-lg">{title}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-fg-muted">{body}</p>
          </article>
        ))}
      </div>

      <dl class="mt-16 grid gap-10 border-t border-line pt-12 md:grid-cols-3" data-reveal="stagger">
        {principles.map((p) => (
          <div>
            <dt class="text-lg">{p.title}</dt>
            <dd class="mt-2 text-[0.9375rem] leading-relaxed text-fg-muted">{p.body}</dd>
          </div>
        ))}
      </dl>
    </Section>

    <Section
      id="download"
      title="Runs everywhere."
      lead={`macOS, Windows, Linux, Android and iOS. Builds are published on GitHub Releases. Current version ${manifest.version}.`}
      class="border-t border-line"
    >
      <div data-reveal>
        <Downloader platforms={platforms} />
      </div>

      <p class="mt-8 text-sm text-fg-subtle" data-reveal>
        <a
          href={RELEASES_URL}
          class="underline underline-offset-4 transition-colors duration-300 hover:text-accent"
          target="_blank"
          rel="noopener"
        >
          All releases
        </a>
        <span class="mx-2">/</span>
        <a
          href={CHECKSUMS_URL}
          class="underline underline-offset-4 transition-colors duration-300 hover:text-accent"
        >
          SHA256SUMS
        </a>
      </p>
    </Section>

    <Section
      id="sponsor"
      title="Sponsor Concat."
      lead="Concat is free and open source, and stays that way. Sponsorship funds continued development, updates, and the store releases on the roadmap."
      class="border-t border-line"
    >
      <div class="grid gap-4 md:grid-cols-2" data-reveal="stagger">
        {SPONSOR_TIERS.map((tier) => (
          <article
            class={cn(
              'hairline flex flex-col rounded-xl border bg-bg-raised p-7',
              tier.recommended ? 'border-accent' : 'border-line',
            )}
          >
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-lg">{tier.name}</h3>
              {tier.recommended && (
                <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
                  Recommended
                </span>
              )}
            </div>
            <p class="mt-4 flex items-baseline gap-1.5">
              <span class="text-4xl font-medium tracking-tight">{formatPrice(tier.price)}</span>
              <span class="text-[0.9375rem] text-fg-muted">/ month</span>
            </p>
            <ul class="mt-6 mb-8 flex flex-col gap-2 text-[0.9375rem] leading-relaxed text-fg-muted">
              {tier.benefits.map((benefit) => (
                <li class="flex gap-3">
                  <Check class="mt-1 size-4 shrink-0 text-accent" aria-hidden="true" />
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
            <Button
              href="#contact"
              variant={tier.recommended ? 'primary' : 'secondary'}
              class="mt-auto w-full"
            >
              Get in touch
            </Button>
          </article>
        ))}
      </div>

      <p class="mt-8 max-w-2xl text-[0.9375rem] leading-relaxed text-fg-muted" data-reveal>
        Tiers are monthly. For as long as you sponsor, you or your company are listed on the{' '}
        <a
          href={REPO_URL}
          class="underline underline-offset-4 transition-colors duration-300 hover:text-accent"
          target="_blank"
          rel="noopener"
        >
          Concat repository
        </a>{' '}
        with name, description, logo and a link.
      </p>
    </Section>

    <Section
      id="contact"
      title="Contact."
      lead="Sponsoring starts with a message. Say which tier you have in mind and how you or your company should appear on the repository."
      class="border-t border-line"
    >
      <div class="grid gap-4 md:grid-cols-2" data-reveal="stagger">
        <article class="hairline rounded-xl border border-line bg-bg-raised p-7">
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="size-5 text-accent"
          >
            <path d={siDiscord.path}></path>
          </svg>
          <h3 class="mt-6 text-lg">Discord</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-fg-muted">
            Join the Concat server and send a message.
          </p>
          <Button
            href={DISCORD_URL}
            variant="secondary"
            class="mt-6"
            target="_blank"
            rel="noopener"
          >
            Join the server
          </Button>
        </article>
        {CONTACT_EMAIL && (
          <article class="hairline rounded-xl border border-line bg-bg-raised p-7">
            <Mail class="size-5 text-accent" aria-hidden="true" />
            <h3 class="mt-6 text-lg">Email</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-fg-muted">
              For anything longer, or if you are not on Discord.
            </p>
            <Button href={`mailto:${CONTACT_EMAIL}`} variant="secondary" class="mt-6">
              {CONTACT_EMAIL}
            </Button>
          </article>
        )}
      </div>
    </Section>
  </main>

  <Footer />
</Base>

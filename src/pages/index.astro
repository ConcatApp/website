---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Section from '@/components/Section.astro';
import DownloadButton from '@/components/DownloadButton.astro';
import Downloader from '@/components/Downloader.astro';
import Button from '@/components/Button.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import Tour, { type Step } from '@/components/Tour.astro';
import {
  ArrowRight,
  AudioLines,
  Braces,
  Check,
  ChevronDown,
  Film,
  GitPullRequest,
  Mail,
  Plus,
  ScanFace,
  Spline,
  Terminal,
  Upload,
  UserX,
} from '@lucide/astro';
import { siDiscord } from 'simple-icons';
import {
  DISCORD_URL,
  RELEASES_URL,
  REPO_URL,
  checksumsUrl,
  getManifest,
  getPlatforms,
} from '@/lib/releases';
import { formatCount, getStats } from '@/lib/stats';
import { SPONSOR_BENEFITS, SPONSORS } from '@/lib/sponsor';
import { CONTACT_EMAIL } from '@/lib/contact';
import mark from '@/assets/mark.png';
import editor from '@/assets/editor.png';
import shotCaptions from '@/assets/feature-captions.png';
import shotTitles from '@/assets/feature-titles.png';
import shotVoices from '@/assets/feature-voices.png';

const { manifest } = await getManifest();
const platforms = getPlatforms(manifest);
const { stats } = await getStats();
const macos = platforms.find((p) => p.id === 'macos');

// Real numbers only: the two counts come from GitHub at build time, the third is the README's
// own figure.
const facts = [
  { value: formatCount(stats.downloads, { plus: true }), label: 'Downloads from GitHub Releases' },
  { value: formatCount(stats.stars), label: 'Stars on GitHub' },
  { value: '100', label: 'Effects, filters and transitions' },
];

const tour: Step[] = [
  {
    title: 'One window, four panes.',
    body: 'Library, monitor, inspector and timeline. Every pane can be swapped, split or dragged somewhere else.',
    region: [0, 0, 1, 1],
  },
  {
    title: 'The Library.',
    body: 'Media, Audio, Text, Stickers, Transitions, Effects, Filters, Adjustments and Templates as pages. Import footage, then single-click a filter to audition it on the monitor or drag it onto a lane.',
    region: [0.006, 0.045, 0.305, 0.56],
  },
  {
    title: 'The monitor.',
    body: 'Scrub, play, step frames. Drag a title or a clip around in the picture; its position, scale and rotation follow. Quality switches between full, half and quarter.',
    region: [0.317, 0.045, 0.455, 0.56],
  },
  {
    title: 'The inspector.',
    body: 'Everything about the selected clip: Text, Effects, Adjust, sound. Font, weight, size, colour, shadow and a background plate for titles, with keyframes a diamond away.',
    region: [0.78, 0.045, 0.215, 0.56],
  },
  {
    title: 'The timeline.',
    body: 'Several tracks, several timelines per project. The tray under the tabs holds split, the razor, the magnetic switch, Text to Speech, Record Voiceover and Generate Captions.',
    region: [0, 0.62, 1, 0.38],
  },
];

// Each card shows a crop of the real window where one exists, and an app-icon style tile on the
// band where none does.
const features = [
  {
    title: 'Auto-captions, offline.',
    body: 'Local Whisper transcribes on your machine and puts styled captions on the timeline, one title per phrase or per sentence.',
    image: shotCaptions,
    alt: 'The Concat timeline with a lane of generated captions above the video and the voice clip',
    href: '/guides/auto-captions',
    cta: 'How captions work',
  },
  {
    title: 'Text to speech and voice cloning.',
    body: 'Built-in speakers that are quick, or any voice from a few seconds of a recording. The result lands on the timeline.',
    image: shotVoices,
    alt: 'The Concat Text to speech sheet with a script, the model and voice pickers and the Generate speech button',
    href: '/guides/text-to-speech',
    cta: 'Generate a voice',
  },
  {
    icon: ScanFace,
    title: 'Background removal.',
    body: 'A person, an object, or paint the mask yourself with a smart brush. No green screen needed.',
    href: '/guides/remove-a-background',
    cta: 'Remove a background',
  },
  {
    icon: Spline,
    title: 'Keyframes with a curve editor.',
    body: 'Position, scale, rotation, opacity, volume and effect parameters. Ease in, ease out, or draw the curve.',
    href: '/guides/keyframes',
    cta: 'Animate anything',
  },
  {
    title: 'Titles that look designed.',
    body: 'Fonts, stroke, shadow and a background plate, with presets to start from. Style many titles at once.',
    image: shotTitles,
    alt: 'The Concat Text inspector with font, weight, size, colour, shadow and background settings',
    href: '/guides/titles-and-text',
    cta: 'Add titles',
  },
  {
    icon: Film,
    title: '4K export, 10-bit, no watermark.',
    body: 'H.264, HEVC and AV1 up to 4K 60. Hardware encoders where the machine has them, and a bitrate that starts at what YouTube asks for.',
    href: '/guides/export',
    cta: 'Export a video',
  },
];

const sides = [
  {
    id: 'for-you',
    eyebrow: 'For people who edit',
    title: 'Install it, drop footage in, cut.',
    rows: [
      { icon: UserX, term: 'Account', text: 'None. Nothing to sign up for and nothing to renew.' },
      {
        icon: Upload,
        term: 'Upload',
        text: 'None. The engine, the models and your footage stay on your disk.',
      },
      {
        icon: Check,
        term: 'Watermark',
        text: 'None, at any resolution. There is no paid tier to unlock and never will be.',
      },
    ],
    cta: { label: 'Read the guides', href: '/guides' },
  },
  {
    id: 'for-machines',
    eyebrow: 'For scripts and agents',
    title: 'Anything the window can do, a program can do.',
    rows: [
      {
        icon: Braces,
        term: 'API',
        text: 'An MCP server built into the app for AI agents (concat --mcp), and JSON-RPC from the open window for scripts. A build from source adds gRPC.',
      },
      {
        icon: Terminal,
        term: 'CLI',
        text: 'Create, import, edit and export from a shell, with a build from source.',
      },
      {
        icon: AudioLines,
        term: 'Same engine',
        text: 'Same commands, same clamps, same refusals as the editor. A method added to the API reaches every transport.',
      },
    ],
    cta: { label: 'Read the developer docs', href: '/docs' },
  },
];

const more = [
  {
    icon: GitPullRequest,
    title: 'Contribute',
    body: 'Use a build and say where it breaks, or pick up an issue. CONTRIBUTING covers setup, the layout of the tree and the checks to run.',
    href: `${REPO_URL}/blob/main/CONTRIBUTING.md`,
    cta: 'Read the contributing guide',
    external: true,
  },
];

const faq = [
  {
    q: 'Is Concat really free?',
    a: 'Yes. No watermark, no account, no paid tier, and the code is AGPL-3.0. Sponsorship is what stands in for a subscription, and it is optional.',
  },
  {
    q: 'Does anything leave my machine?',
    a: 'No. Editing, captions, voices and cutout all run locally. The optional models download once from Settings and work offline after that. Logs stay on disk unless you attach them to an issue yourself.',
  },
  {
    q: 'Where is the text-to-speech button?',
    a: 'On the timeline tray, the row of tools under the timeline tabs: the Text to Speech button opens the speech panel. The first time, download a voice model from Settings › Speech.',
    link: { href: '/guides/text-to-speech', label: 'The text-to-speech guide' },
  },
  {
    q: 'Windows SmartScreen stops the installer.',
    a: 'The Windows builds are not code-signed yet, so SmartScreen asks before the first run: click More info, then Run anyway. Where Smart App Control is on, Windows refuses unsigned programs outright.',
    link: { href: `${REPO_URL}/blob/main/CODE_SIGNING.md`, label: 'The code signing policy' },
  },
  {
    q: 'macOS says the app is damaged or cannot be opened.',
    a: 'The macOS builds are unsigned. Move Concat to Applications, then clear the quarantine flag once:',
    code: macos?.command,
  },
  {
    q: 'How do I install it on iPhone or iPad?',
    a: 'iOS is in beta and is not on the App Store. Download the IPA from the picker and install it by sideloading.',
  },
  {
    q: 'What hardware do I need?',
    a: 'Minimum: any 64-bit processor from 2013 or later, 4 GB of RAM and 500 MB of storage, with no GPU required. For smooth 1080p editing and quick 4K exports: 6 cores or more, a GPU with Metal, DirectX 12 or Vulkan, and 16 GB of RAM.',
    link: { href: '/guides/system-requirements', label: 'System requirements' },
  },
  {
    q: 'Where does sponsorship money go?',
    a: 'Into continued development and updates. Every sponsor gets a place on the repository and on this page for the months they sponsor.',
    link: { href: '#sponsor', label: 'Sponsor Concat' },
  },
];

// Structured data for search engines: the site, the app as a free, cross-platform application,
// and the FAQ below (the answers as written on the page).
const site = Astro.site?.toString();
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Concat',
    url: site,
    description: 'The free, open-source CapCut replacement.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Concat',
    description:
      'The free, open-source CapCut replacement. A video editor with auto-captions, text-to-speech, background removal, keyframes, effects and 4K export that runs entirely on your machine.',
    applicationCategory: 'MultimediaApplication',
    applicationSubCategory: 'Video editor',
    operatingSystem: 'Windows, macOS, Linux, Android, iOS',
    softwareVersion: manifest.version,
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    downloadUrl: RELEASES_URL,
    image: site ? new URL('/og.png', site).toString() : undefined,
    screenshot: site ? new URL('/og.png', site).toString() : undefined,
    featureList: [
      'Auto-captions with local Whisper',
      'Text-to-speech and voice cloning',
      'Background removal',
      'Keyframes with a curve editor',
      '100 effects, filters and transitions',
      'Multi-track and multi-timeline editing',
      'Export in H.264, HEVC and AV1 up to 4K 60 10-bit',
      'Built-in MCP server for AI agents',
    ],
    url: site,
    sameAs: [REPO_URL, DISCORD_URL],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.code ? `${item.a} ${item.code}` : item.a,
      },
    })),
  },
];
---

<Base
  title="Concat: the free, open-source CapCut replacement"
  description="A free video editor with auto-captions, text-to-speech, background removal, effects and 4K export that runs entirely on your machine. No watermark, no account, no subscription."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)}></script>
  <Header />

  <main>
    <!-- Hero: the mark, a two-line headline, one line, one button. -->
    <section class="pt-16" aria-labelledby="hero-title">
      <div class="container-x grid justify-items-center pt-[clamp(56px,7vw,88px)] pb-[clamp(56px,7vw,88px)] text-center">
        <Image
          src={mark}
          alt="Concat app icon"
          width={148}
          height={148}
          loading="eager"
          class="size-[74px] rounded-[18.5%] shadow-frame ring-1 ring-white/12"
          data-reveal
        />
        <h1 id="hero-title" class="text-display mt-12 sm:mt-14" data-reveal>
          <span class="grad grad-a">The free, open-source</span>
          <br />
          <span class="grad grad-b">CapCut replacement.</span>
        </h1>
        <p class="text-lead mt-4 max-w-[22rem] text-balance text-fg-muted" data-reveal>
          A video editor with captions, voices, effects and 4K export that runs entirely on your
          machine.
        </p>
        <div class="relative mt-7" data-reveal>
          <DownloadButton platforms={platforms} all={false} />
          <!-- A handwritten aside: a curved arrow from the note to the button. -->
          <span class="note hidden sm:block" aria-hidden="true">
            <svg class="note-arrow" viewBox="0 0 66 24" fill="none">
              <path d="M63 6C52 20 24 24 7 9" stroke="currentColor" stroke-linecap="round"></path>
              <path
                d="M8.6 15.8 7 9l7 .8"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
            <span class="note-text">Free forever</span>
          </span>
        </div>
      </div>
    </section>

    <!-- The window, full width, on the band. The band ends in a tab that hangs into the page. -->
    <section class="hero-band band" aria-label="The Concat editor window">
      <div class="frame relative mx-auto w-[min(1032px,100%-32px)] sm:w-[min(1032px,100%-48px)]">
        <Image
          src={editor}
          alt="The Concat video editor: media library on the left, the monitor with a generated caption in the middle, the text inspector on the right and a multi-track timeline below"
          widths={[640, 1024, 1440, 2064]}
          sizes="(min-width: 1080px) 1032px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
      </div>
      <p class="band-tab">No watermark, no account</p>
    </section>

    <Section title={'Everything people open CapCut for.\nNone of the catches.'}>
      <ul class="grid gap-2 sm:grid-cols-3" data-reveal="stagger">
        {facts.map((f) => (
          <li class="tile card flex min-h-[200px] flex-col rounded-[28px] p-6 sm:min-h-[240px] sm:rounded-[40px] sm:p-[34px_37px_37px]">
            <p class="text-stat">{f.value}</p>
            <p class="mt-auto pt-6 text-[14px] tracking-[-0.02em] text-fg-muted">{f.label}</p>
          </li>
        ))}
      </ul>
    </Section>

    <Section
      id="features"
      title={'Built for the edits\npeople make every day.'}
      lead="Captions, voices, titles and effects on a multi-track timeline, rendered by a native Rust engine with a GPU compositor."
    >
      <ul class="grid gap-2 md:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
        {features.map(({ icon: Icon, ...f }) => (
          <li class="card flex flex-col items-center rounded-[28px] px-6 pt-6 pb-8 text-center sm:rounded-[40px]">
            <div class="grid h-[208px] w-full place-items-center">
              {f.image ? (
                <Image
                  src={f.image}
                  alt={f.alt ?? ''}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 1024px) 320px, (min-width: 768px) 45vw, 90vw"
                  class="block h-[184px] w-auto max-w-full rounded-[14px] object-cover object-left-top shadow-frame ring-1 ring-line-strong"
                />
              ) : (
                Icon && (
                  <span class="band grid size-[112px] place-items-center rounded-[26px] shadow-frame">
                    <Icon class="size-11 text-white" stroke-width={1.5} aria-hidden="true" />
                  </span>
                )
              )}
            </div>
            <h3 class="mt-7 text-[16px] tracking-[-0.02em]">{f.title}</h3>
            <p class="mt-1.5 max-w-[17rem] text-[14px] tracking-[-0.02em] text-fg-muted">
              {f.body}
            </p>
            <ArrowLink href={f.href} class="mt-auto pt-5 text-[14px]">
              {f.cta}
            </ArrowLink>
          </li>
        ))}
      </ul>
    </Section>

    <Section
      id="tour"
      title="A tour of the window."
      lead="Four panes, one screenshot, nothing mocked up. Scroll and the picture follows."
    >
      <Tour image={editor} alt="The Concat editor window" steps={tour} />
    </Section>

    <Section title={'Two ways in,\nthe same engine.'}>
      <div class="grid gap-2 lg:grid-cols-2" data-reveal="stagger">
        {sides.map((s) => (
          <article
            id={s.id}
            class="card flex h-full scroll-mt-24 flex-col rounded-[28px] p-7 sm:rounded-[40px] sm:p-10"
          >
            <p class="eyebrow">{s.eyebrow}</p>
            <h3 class="text-title mt-4 max-w-[16ch]">{s.title}</h3>
            <dl class="mt-8 border-y border-line">
              {s.rows.map(({ icon: Icon, ...r }) => (
                <div class="grid grid-cols-[auto_1fr] items-start gap-x-4 border-t border-line py-4 first:border-t-0 sm:grid-cols-[auto_6.5rem_1fr]">
                  <span class="flex size-9 items-center justify-center rounded-full bg-bg-overlay text-fg">
                    <Icon class="size-4" stroke-width={2} aria-hidden="true" />
                  </span>
                  <dt class="pt-1.5 text-[15px] font-medium">{r.term}</dt>
                  <dd class="col-span-2 pt-1 text-[15px] leading-snug text-fg-muted sm:col-span-1 sm:pt-1.5">
                    {r.text}
                  </dd>
                </div>
              ))}
            </dl>
            <div class="mt-auto pt-8">
              <Button href={s.cta.href} variant="secondary">
                {s.cta.label}
                <ArrowRight class="size-4" stroke-width={2} aria-hidden="true" />
              </Button>
            </div>
          </article>
        ))}
      </div>
    </Section>

    <Section
      id="download"
      title="Runs everywhere."
      lead={`Windows, macOS, Linux, Android and iOS. Every build is a GitHub Releases asset with a checksum. Current version ${manifest.version}.`}
    >
      <div class="band rounded-[28px] p-3 sm:rounded-[40px] sm:p-[30px]" data-reveal>
        <Downloader platforms={platforms} />
      </div>
      <p class="mt-6 text-center text-[14px] text-fg-muted" data-reveal>
        <a
          href={RELEASES_URL}
          class="underline underline-offset-4 transition-colors duration-150 hover:text-fg"
          target="_blank"
          rel="noopener"
        >
          All releases
        </a>
        <span class="mx-2">/</span>
        <a
          href={checksumsUrl(manifest)}
          class="underline underline-offset-4 transition-colors duration-150 hover:text-fg"
        >
          SHA256SUMS
        </a>
        <span class="mx-2">/</span>
        <a
          href="/guides/install"
          class="underline underline-offset-4 transition-colors duration-150 hover:text-fg"
        >
          Install guide
        </a>
      </p>
    </Section>

    <Section
      id="sponsor"
      title="Sponsor Concat."
      lead="Concat has no paywall and never will. Sponsorship stands in for one: it funds continued development and updates."
    >
      <div class="grid gap-2 lg:grid-cols-12" data-reveal="stagger">
        <article class="card flex flex-col rounded-[28px] p-7 sm:rounded-[40px] sm:p-10 lg:col-span-7">
          <p class="eyebrow">Sponsorship</p>
          <h3 class="text-title mt-4">Your name, logo and link, for as long as you sponsor.</h3>
          <ul class="mt-6 grid gap-4 border-t border-line pt-6 text-[16px] font-medium tracking-[-0.02em] text-fg-muted">
            {SPONSOR_BENEFITS.map((benefit) => (
              <li class="flex gap-3.5">
                <span class="mt-0.5 flex size-[23px] shrink-0 items-center justify-center rounded-full border border-fg-muted text-fg">
                  <Check class="size-3" stroke-width={2} aria-hidden="true" />
                </span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 max-w-xl text-[14px] leading-relaxed text-fg-muted">
            Sponsorship is monthly and priced over a message. The listing lives on the{' '}
            <a
              href={REPO_URL}
              class="text-fg underline underline-offset-4"
              target="_blank"
              rel="noopener"
            >
              Concat repository
            </a>{' '}
            and on this page.
          </p>
          <div class="mt-auto pt-8">
            <Button href="#contact" size="lg">
              Get in touch
              <ArrowRight class="size-4" stroke-width={2} aria-hidden="true" />
            </Button>
          </div>
        </article>

        <div class="flex flex-col gap-2 lg:col-span-5">
          {SPONSORS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener sponsored"
              class="card flex items-center gap-5 rounded-[28px] p-5"
            >
              <Image
                src={s.logo}
                alt={`${s.name} logo`}
                width={72}
                height={72}
                class="size-16 shrink-0 rounded-2xl"
              />
              <span class="min-w-0">
                <span class="block text-[11px] font-medium tracking-[0.06em] text-fg-subtle uppercase">
                  Current sponsor
                </span>
                <span class="mt-1 block text-lg font-medium tracking-[-0.02em]">{s.name}</span>
                <span class="mt-0.5 block text-[14px] text-fg-muted">{s.description}</span>
                {s.note && <span class="mt-1 block text-xs text-fg-subtle">{s.note}</span>}
              </span>
            </a>
          ))}
          <a
            href="#contact"
            class="flex flex-1 items-center gap-5 rounded-[28px] border border-dashed border-line-strong p-5 transition-colors duration-150 hover:bg-bg-subtle"
          >
            <span class="flex size-16 shrink-0 items-center justify-center rounded-2xl border border-dashed border-line-strong text-fg-subtle">
              <Plus class="size-6" aria-hidden="true" />
            </span>
            <span>
              <span class="block text-lg font-medium tracking-[-0.02em]">Your logo here</span>
              <span class="mt-0.5 block text-[14px] text-fg-muted">
                Sponsor Concat and your name, logo and link take this slot.
              </span>
            </span>
          </a>
        </div>
      </div>
    </Section>

    <Section
      id="contact"
      title="Contact."
      lead="Sponsoring starts with a message. Tell us about you or your company and how you should appear on the repository and this page."
    >
      <div class="grid gap-2 md:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
        <article class="card flex flex-col rounded-[28px] p-7 sm:rounded-[32px] sm:p-8">
          <span class="flex size-10 items-center justify-center rounded-full bg-bg-overlay text-fg">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-5">
              <path d={siDiscord.path}></path>
            </svg>
          </span>
          <h3 class="mt-5 text-lg tracking-[-0.02em]">Discord</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">
            Join the Concat server and send a message. Questions and bug reports are welcome there
            too.
          </p>
          <Button
            href={DISCORD_URL}
            variant="secondary"
            class="mt-6 w-fit"
            target="_blank"
            rel="noopener"
          >
            Join the server
          </Button>
        </article>
        {CONTACT_EMAIL && (
          <article class="card flex flex-col rounded-[28px] p-7 sm:rounded-[32px] sm:p-8">
            <span class="flex size-10 items-center justify-center rounded-full bg-bg-overlay text-fg">
              <Mail class="size-5" aria-hidden="true" />
            </span>
            <h3 class="mt-5 text-lg tracking-[-0.02em]">Email</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">
              For anything longer, or if you are not on Discord.
            </p>
            <Button href={`mailto:${CONTACT_EMAIL}`} variant="secondary" class="mt-6 w-fit">
              {CONTACT_EMAIL}
            </Button>
          </article>
        )}
        {more.map(({ icon: Icon, ...m }) => (
          <article class="card flex flex-col rounded-[28px] p-7 sm:rounded-[32px] sm:p-8">
            <span class="flex size-10 items-center justify-center rounded-full bg-bg-overlay text-fg">
              <Icon class="size-5" aria-hidden="true" />
            </span>
            <h3 class="mt-5 text-lg tracking-[-0.02em]">{m.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">{m.body}</p>
            <ArrowLink
              href={m.href}
              class="mt-auto pt-5"
              target={m.external ? '_blank' : undefined}
              rel={m.external ? 'noopener' : undefined}
            >
              {m.cta}
            </ArrowLink>
          </article>
        ))}
      </div>
    </Section>

    <section id="faq" class="scroll-mt-20" aria-labelledby="faq-title">
      <div class="container-x section-y grid items-start gap-x-16 gap-y-6 lg:grid-cols-[5fr_7fr]">
        <div data-reveal>
          <h2 id="faq-title" class="text-display-sm">
            Frequently
            <br />
            asked questions.
          </h2>
          <p class="mt-4 text-[15px] text-fg-muted">
            Anything else, ask on{' '}
            <a
              href={DISCORD_URL}
              class="text-fg underline underline-offset-4"
              target="_blank"
              rel="noopener"
            >
              Discord
            </a>{' '}
            or read the{' '}
            <a href="/guides" class="text-fg underline underline-offset-4">
              guides
            </a>
            .
          </p>
        </div>
        <div data-reveal>
          {faq.map((item) => (
            <details class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-[18px] font-medium tracking-[-0.01em] [&::-webkit-details-marker]:hidden">
                <h3 class="text-[16px] tracking-[-0.01em]">{item.q}</h3>
                <ChevronDown
                  class="size-4 shrink-0 text-fg-muted transition-transform duration-200 group-open:rotate-180"
                  stroke-width={1.75}
                  aria-hidden="true"
                />
              </summary>
              <div class="max-w-[40rem] pb-[18px] text-[15px] leading-relaxed text-fg-muted">
                <p>{item.a}</p>
                {item.code && (
                  <code class="mt-3 block w-fit rounded-md border border-line bg-card px-3 py-2 font-mono text-xs text-fg select-all">
                    {item.code}
                  </code>
                )}
                {item.link && (
                  <ArrowLink href={item.link.href} class="mt-3 text-[14px]">
                    {item.link.label}
                  </ArrowLink>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer>
    <Fragment slot="cta">
      <h2 class="text-[clamp(2.125rem,1.4rem+2.4vw,2.875rem)] leading-[1.05] tracking-[-0.02em]">
        Make something
        <br />
        worth watching.
      </h2>
      <p class="text-lead mx-auto mt-4 text-fg-muted">
        Free and open source · Windows, macOS, Linux, Android and iOS
      </p>
      <div class="mt-7 flex justify-center">
        <DownloadButton platforms={platforms} all={false} />
      </div>
    </Fragment>
  </Footer>
</Base>


{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "shots": "node scripts/screenshot.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name concatenate --branch main"
  },
  "dependencies": {
    "@lucide/astro": "^1.47.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.11.0",
    "simple-icons": "^16.32.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.135.0"
  }
}
